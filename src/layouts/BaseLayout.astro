---
import { Font } from "astro:assets";
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, "https://aphananthe42.net");
const ogpImageURL = new URL("/ogp.png", canonicalURL);
const websiteTitle = "aphananthe42.net";
type Locale = "en" | "ja";
interface Props {
    locale?: Locale;
    showLanguageSwitcher?: boolean;
}
const { locale = "en", showLanguageSwitcher = false } = Astro.props;
---

<html lang={locale}>
    <head prefix="og: https://ogp.me/ns#">
        <meta charset="utf-8" />
        <meta name="description" content="aphananthe42's personal website" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <title>{websiteTitle}</title>

        <meta property="og:url" content={canonicalURL} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={websiteTitle} />
        <meta
            property="og:description"
            content="aphananthe42's personal website"
        />
        <meta property="og:site_name" content={websiteTitle} />
        <meta property="og:image" content={ogpImageURL} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@aphananthe42" />
        <Font cssVariable="--font-roboto" preload />
        <Font cssVariable="--font-notosansjp" preload />
    </head>
    <body class="page-grid w-screen min-h-screen flex flex-col bg-page">
        <header>
            <div class="flex items-center justify-between p-3">
                <a
                    href={locale === "ja" ? "/ja/" : "/"}
                    class="text-fg font-roboto-tw font-bold"
                >
                    aphananthe42.net
                </a>
                {
                    showLanguageSwitcher && (
                        <nav
                            class="mr-3 flex items-center gap-1 font-roboto-tw text-sm"
                            aria-label="Language"
                        >
                            <a
                                href="/"
                                class={
                                    locale === "en"
                                        ? "text-fg"
                                        : "text-fg-muted hover:text-fg"
                                }
                            >
                                EN
                            </a>
                            <span class="text-fg-muted">/</span>
                            <a
                                href="/ja/"
                                class={
                                    locale === "ja"
                                        ? "text-fg"
                                        : "text-fg-muted hover:text-fg"
                                }
                            >
                                JA
                            </a>
                        </nav>
                    )
                }
            </div>
        </header>
        <main class="flex-grow">
            <slot />
        </main>
        <footer class="h-14 mt-10 lg:mt-20 mb-0">
            <hr />
            <p
                class="text-fg text-sm lg:text-lg text-center font-roboto-tw font-normal p-6 lg:p-16"
            >
                © 2026 aphananthe42
            </p>
        </footer>
    </body>
</html>
