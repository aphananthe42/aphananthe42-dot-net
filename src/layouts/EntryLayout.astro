---
import Prose from "../components/Prose.astro";
---

<article class="w-3/4 xl:w-2/5 mx-auto my-10 lg:my-20 font-notosansjp-tw">
    <header class="border-b border-outline pb-5">
        <h1 class="text-fg text-2xl lg:text-4xl font-bold">
            <slot name="title" />
        </h1>
        <p class="mt-3 text-right text-fg-body">
            <slot name="date" />
        </p>
    </header>
    <Prose>
        <slot name="content" />
    </Prose>
    <div class="mt-10 flex justify-end">
        <a
            href="/diary/"
            class="font-roboto-tw text-link underline decoration-link/50 underline-offset-4 transition-colors duration-200 hover:text-link-hover"
            >Back to diary</a
        >
    </div>
</article>
