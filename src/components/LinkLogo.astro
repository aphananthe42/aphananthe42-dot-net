---
import { Image } from "astro:assets";
import GithubIcon from "../images/github_icon.svg";
import XIcon from "../images/x_icon.svg";
import ZennIcon from "../images/zenn_icon.svg";
import AtCoderIcon from "../images/atcoder_icon.png";

type LinkType = "GitHub" | "X" | "Zenn" | "AtCoder";
interface Props {
    href: string;
    linkType: LinkType;
}

const { href, linkType } = Astro.props;
const icon = (() => {
    switch (linkType) {
        case "GitHub":
            return GithubIcon;
        case "X":
            return XIcon;
        case "Zenn":
            return ZennIcon;
        case "AtCoder":
            return AtCoderIcon;
    }
})();
---

<a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${linkType}を新しいタブで開く`}
  class="group flex h-12 w-12 items-center justify-center rounded-full border border-outline bg-surface transition-colors duration-200 hover:border-outline-hover hover:bg-surface-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus lg:h-20 lg:w-20"
>
    <Image
        class="h-6 w-6 object-contain opacity-80 transition-opacity duration-200 group-hover:opacity-100 lg:h-10 lg:w-10"
        src={icon}
        alt={`${linkType}のアイコン`}
    />
</a>
