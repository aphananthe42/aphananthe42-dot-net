---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import MainIcon from "../images/main_icon.png";
import { translations, type Locale } from "../i18n";
import { site } from "../data/site";
import SectionLayout from "../layouts/SectionLayout.astro";
import Separator from "./Separator.astro";
import LinkLogo from "./LinkLogo.astro";
import WorkCard from "./WorkCard.astro";
import TechTag from "./TechTag.astro";

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const t = translations[locale];
const latestDiaryEntries = (await getCollection("diary"))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 3);
const techGroups = t.about.techGroups as Array<[string, string[]]>;
const workDescriptions = { site: t.works.site, app: t.works.app };
---

<section>
    <Image
        class="w-1/3 xl:w-1/12 aspect-square mx-auto mt-20 rounded-full"
        src={MainIcon}
        alt={site.name}
    /><h1
        class="text-fg text-3xl lg:text-6xl text-center font-roboto-tw font-bold mt-9 lg:mt-20"
    >
        {site.name}
    </h1><div class="flex justify-center gap-4 lg:gap-10 mt-6 lg:mt-12">
        {site.socialLinks.map((link) => <LinkLogo {...link} />)}
    </div>
</section>
<Separator />
<SectionLayout title={t.sections.about}
    ><div
        class="mt-4 text-[15px] lg:text-xl text-fg font-notosansjp-tw"
    >
        <div class="border-l-2 border-outline pl-4">
            <p class="font-roboto-tw font-bold">{t.about.role}</p><p
              class="mt-1 text-fg-body"
            >
                {t.about.bioIntro}<br />{t.about.bioOutro}
            </p>
        </div><div class="mt-4 grid gap-4">
            <div class="rounded-lg border border-outline bg-surface p-5 lg:p-6">
                <h2 class="font-roboto-tw text-lg font-bold lg:text-2xl">
                    {t.about.what}
                </h2><ul
                    class="mt-3 list-disc space-y-1 pl-5 marker:text-fg-muted"
                >
                    {t.about.tasks.map((task) => <li>{task}</li>)}
                </ul>
            </div><div
                class="rounded-lg border border-outline bg-surface p-5 lg:p-6"
            >
                <h2 class="font-roboto-tw text-lg font-bold lg:text-2xl">
                    {t.about.tech}
                </h2><div class="mt-3 space-y-3 text-sm lg:text-base">
                    {
                        techGroups.map(([label, tags]) => (
                            <div>
                                <>
                                    <p class="text-fg-muted">{label}</p>
                                    <div class="mt-1 flex flex-wrap gap-2">
                                        {tags.map((tag) => (
                                            <TechTag>{tag}</TechTag>
                                        ))}
                                    </div>
                                </>
                            </div>
                        ))
                    }
                </div>
            </div><div
                class="rounded-lg border border-outline bg-surface p-5 lg:p-6"
            >
                <h2 class="font-roboto-tw text-lg font-bold lg:text-2xl">
                    {t.about.certifications}
                </h2><ul
                    class="mt-3 list-disc space-y-1 pl-5 marker:text-fg-muted"
                >
                    {t.about.certificationsList.map((item) => <li>{item}</li>)}
                </ul>
            </div><div
                class="rounded-lg border border-outline bg-surface p-5 lg:p-6"
            >
                <h2 class="font-roboto-tw text-lg font-bold lg:text-2xl">
                    {t.about.languages}
                </h2><ul
                    class="mt-3 list-disc space-y-1 pl-5 marker:text-fg-muted"
                >
                    {t.about.languagesList.map((item) => <li>{item}</li>)}
                </ul><p class="mt-6 border-t border-outline pt-4">
                    <span class="font-roboto-tw font-bold">MBTI:</span> {site.mbti}
                </p>
            </div>
        </div>
    </div></SectionLayout
>
<Separator />
<SectionLayout title={t.sections.works}
    ><div class="mt-4 space-y-4">
        {site.works.map((work) => (
            <WorkCard title={work.title} href={work.href}>
                <Fragment slot="description">{workDescriptions[work.id]}</Fragment>
                <Fragment slot="tech-stacks">
                    {work.tags.map((tag) => <TechTag>{tag}</TechTag>)}
                </Fragment>
            </WorkCard>
        ))}
    </div></SectionLayout
>
<Separator />
<SectionLayout title={t.sections.diary}
    ><div class="mt-4">
        <ul class="space-y-3">
            {
                latestDiaryEntries.map((entry) => (
                    <li>
                        <a
                            href={`/diary/${entry.id}`}
                            class="flex h-14 items-center justify-between gap-4 rounded-lg border border-outline bg-surface px-4 transition-colors duration-200 hover:border-outline-hover hover:bg-surface-hover lg:h-16"
                        >
                            <>
                                <p class="font-roboto-tw text-sm font-bold text-fg-strong lg:text-base">
                                    {entry.data.title}
                                </p>
                                <time
                                    class="shrink-0 text-sm text-fg-body lg:text-base"
                                    datetime={entry.data.date.toISOString()}
                                >
                                    {entry.data.date.toISOString().slice(0, 10)}
                                </time>
                            </>
                        </a>
                    </li>
                ))
            }
        </ul><div class="mt-4 flex justify-end">
            <a
                href="/diary/"
                class="font-roboto-tw text-base font-bold text-link underline decoration-link/50 underline-offset-4 hover:text-link-hover lg:text-xl"
                >{t.diary.viewAll}</a
            >
        </div>
    </div></SectionLayout
>
<Separator />
<SectionLayout title={t.sections.contact}
    ><div
        class="mt-4 space-y-2 font-roboto-tw text-base lg:text-xl"
    >
        <p>
            <span class="text-fg-muted">{t.contact.email}</span>
            <a
                href={`mailto:${site.email}`}
                class="font-bold text-link underline decoration-link/50 underline-offset-4 hover:text-link-hover"
                >{site.email}</a
            >
        </p><p>
            <span class="text-fg-muted">{t.contact.x}</span>
            <a
                href={site.socialLinks[1].href}
                class="font-bold text-link underline decoration-link/50 underline-offset-4 hover:text-link-hover"
                >{t.contact.dm}</a
            >
        </p><p class="pt-1 text-sm lg:text-base">
            <a
                href="/pgp"
                class="text-fg-muted underline decoration-outline-hover/60 underline-offset-4 hover:text-fg-tag"
                >{t.contact.pgp}</a
            >
        </p>
    </div></SectionLayout
>
