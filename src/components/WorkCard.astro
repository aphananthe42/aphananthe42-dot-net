---
interface Props {
    title: string;
    href: string;
}

const { title, href } = Astro.props;
---

<article class="rounded-lg border border-outline bg-surface p-5 lg:p-6">
    <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="font-roboto-tw text-lg font-bold text-link underline decoration-link/50 underline-offset-4 transition-colors duration-200 hover:text-link-hover lg:text-2xl"
    >
        {title}
    </a>
    <p class="mt-3 text-base text-fg-body lg:text-xl">
        <slot name="description" />
    </p>
    <div class="mt-4 flex flex-wrap gap-2 text-sm text-fg-tag lg:text-base">
        <slot name="tech-stacks" />
    </div>
</article>
