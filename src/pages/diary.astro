---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryListLayout from "../layouts/EntryListLayout.astro";

const diaryEntries = await getCollection("diary");
---

<BaseLayout>
    <EntryListLayout title="Diary">
        {
            diaryEntries
                .sort(
                    (a, b) =>
                        (b.data.date as Date).getTime() -
                        (a.data.date as Date).getTime(),
                )
                .map((entry) => (
                    <div class="mt-4 rounded-xl border border-outline bg-surface p-3 transition-colors duration-200 hover:border-outline-hover hover:bg-surface-hover">
                        <a href={`/diary/${entry.id}`} class="block">
                            <p class="text-lg text-fg-strong">
                                {entry.data.title}
                            </p>
                            <p class="text-right text-fg-body">
                                {entry.data.date.toISOString().slice(0, 10)}
                            </p>
                        </a>
                    </div>
                ))
        }
    </EntryListLayout>
</BaseLayout>
